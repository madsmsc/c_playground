{
    "version": "2.0.0",
    "tasks": [
        //
        // CMAKE TASKS
        //
        {
            "label": "CMake: build",
            "type": "cmake",
            "command": "build",
            "targets": [
                "all"
            ],
            "preset": "c_playground",
            "group": "build",
            "detail": "Build application"
        },
        {
            "label": "CMake: clean rebuild",
            "type": "cmake",
            "command": "cleanRebuild",
            "targets": [
                "all"
            ],
            "preset": "c_playground",
            "group": "build",
            "detail": "Clean and build application"
        },
        {
            "label": "CMake: clean only!",
            "type": "cmake",
            "command": "clean",
            "targets": [
                "all"
            ],
            "preset": "c_playground",
            "group": "build",
            "detail": "Clean and build application"
        },
        //
        // NATIVE TASKS
        //
        {
            "label": "native clean",
            "type": "shell",
            "command": "del",
            "args": [
                "out/*"
            ],
            "problemMatcher": []
        },
        {
            "label": "native build",
            "type": "shell",
            "command": "gcc",
            "args": [
                // sources
                "src/main.c",
                "src/mem/mem.c",
                "src/mem/mem_graph.c",
                "src/mem/mem_arena.c",
                "src/list.c",
                "src/str.c",
                "src/err.c",
                "src/book.c",
                // flags
                "-g", // for debugging
                "-Wall", // all warnings
                "-Wextra", // more warnings
                // output
                "-o",
                "out/main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "native run",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "out\\main.exe"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "native",
            "dependsOn": [
                "native clean",
                "native build",
                "native run"
            ],
            "dependsOrder": "sequence",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
